{
  "name": "AutoOptionalChainer",
  "publisher": "ctafsiras",
  "author": "Tafsir Chowdhury",
  "license": "MIT",
  "displayName": "Auto Optional Chainer",
  "description": "This is an extension to put optional chaining automatically in js/ts where it needs.",
  "version": "0.0.7",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tafsirc/auto-optional-chainer"
  },
  "bugs": {
    "url": "https://github.com/tafsirc/auto-optional-chainer/issues"
  },
  "homepage": "https://github.com/tafsirc/auto-optional-chainer#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "vscode",
    "optional-chaining",
    "typescript",
    "javascript",
    "vue",
    "svelte",
    "astro",
    "web"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "browser": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "AutoOptionalChainer.applyOptionalChaining",
        "title": "Apply Optional Chaining"
      },
      {
        "command": "AutoOptionalChainer.applyToSelection",
        "title": "Apply Optional Chaining to Selection"
      },
      {
        "command": "AutoOptionalChainer.toggleApplyOnSave",
        "title": "Toggle Apply on Save"
      }
    ],
    "configuration": {
      "title": "Auto Optional Chainer",
      "properties": {
        "autoOptionalChainer.applyOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply optional chaining when saving supported files"
        },
        "autoOptionalChainer.enableShortcut": {
          "type": "boolean",
          "default": false,
          "description": "Enable keyboard shortcut for applying optional chaining"
        },
        "autoOptionalChainer.ignoredIdentifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom identifiers or global singletons to ignore during optional chaining"
        }
      }
    },
    "keybindings": [
      {
        "command": "AutoOptionalChainer.applyOptionalChaining",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "editorTextFocus && config.autoOptionalChainer.enableShortcut"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "mocha --ui tdd out/test/transformer.test.js",
    "coverage": "c8 --reporter=text --reporter=lcov mocha --ui tdd out/test/transformer.test.js",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
