{
  "name": "AutoOptionalChainer",
  "publisher": "ctafsiras",
  "author": "Tafsir Chowdhury",
  "license": "MIT",
  "displayName": "Auto Optional Chainer",
  "description": "This is an extension to put optional chaining automatically in js/ts where it needs.",
  "version": "0.0.7",
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tafsirc/auto-optional-chainer"
  },
  "bugs": {
    "url": "https://github.com/tafsirc/auto-optional-chainer/issues"
  },
  "homepage": "https://github.com/tafsirc/auto-optional-chainer#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "AutoOptionalChainer.applyOptionalChaining",
        "title": "Apply Optional Chaining"
      }
    ],
    "configuration": {
      "title": "Auto Optional Chainer",
      "properties": {
        "autoOptionalChainer.applyOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply optional chaining when saving supported files"
        },
        "autoOptionalChainer.enableShortcut": {
          "type": "boolean",
          "default": false,
          "description": "Enable keyboard shortcut for applying optional chaining"
        }
      }
    },
    "keybindings": [
      {
        "command": "AutoOptionalChainer.applyOptionalChaining",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "editorTextFocus && config.autoOptionalChainer.enableShortcut"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
